# Vec push and index: fills a Vec[int] by push, then reads and writes it by index.
# expect: stdout "96391344\n"

import std/vec
import std/io

fn main() {
    total := 0
    for round in 0..40 {
        xs: Vec[int] = []
        for i in 0..1000000 { xs.push(i ^ round) }
        n := xs.len()
        for i in 1..n { xs[i] = xs[i] + xs[i - 1] % 7 }
        for i in 0..n { total = (total + xs[i]) % 1000000007 }
    }
    io.println(total)
}
