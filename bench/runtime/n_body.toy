# The Benchmarks Game n-body: the Jovian planets around the Sun, advanced by a simple
# symplectic integrator with dt = 0.01. Prints the system's energy before and after
# 2,000,000 steps, as the shortest digits that read back as the same float.
# expect: stdout "-0.16907516382852447 -0.16902628585285398\n"

import std/vec
import std/math
import std/io

struct Body { x: float, y: float, z: float, vx: float, vy: float, vz: float, mass: float }

fn neg(x: float) -> float { 0.0 -. x }

fn planets() -> Vec[Body] {
    pi := 3.141592653589793
    solar_mass := 4.0 *. pi *. pi
    days := 365.24
    sun := Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar_mass }
    jupiter := Body {
        x: 4.84143144246472090e+00,
        y: neg(1.16032004402742839e+00),
        z: neg(1.03622044471123109e-01),
        vx: 1.66007664274403694e-03 *. days,
        vy: 7.69901118419740425e-03 *. days,
        vz: neg(6.90460016972063023e-05) *. days,
        mass: 9.54791938424326609e-04 *. solar_mass,
    }
    saturn := Body {
        x: 8.34336671824457987e+00,
        y: 4.12479856412430479e+00,
        z: neg(4.03523417114321381e-01),
        vx: neg(2.76742510726862411e-03) *. days,
        vy: 4.99852801234917238e-03 *. days,
        vz: 2.30417297573763929e-05 *. days,
        mass: 2.85885980666130812e-04 *. solar_mass,
    }
    uranus := Body {
        x: 1.28943695621391310e+01,
        y: neg(1.51111514016986312e+01),
        z: neg(2.23307578892655734e-01),
        vx: 2.96460137564761618e-03 *. days,
        vy: 2.37847173959480950e-03 *. days,
        vz: neg(2.96589568540237556e-05) *. days,
        mass: 4.36624404335156298e-05 *. solar_mass,
    }
    neptune := Body {
        x: 1.53796971148509165e+01,
        y: neg(2.59193146099879641e+01),
        z: 1.79258772950371181e-01,
        vx: 2.68067772490389322e-03 *. days,
        vy: 1.62824170038242295e-03 *. days,
        vz: neg(9.51592254519715870e-05) *. days,
        mass: 5.15138902046611451e-05 *. solar_mass,
    }
    return [sun, jupiter, saturn, uranus, neptune]
}

fn offset_momentum(bodies: Vec[Body]) {
    px := 0.0
    py := 0.0
    pz := 0.0
    for b in bodies {
        px +.= b.vx *. b.mass
        py +.= b.vy *. b.mass
        pz +.= b.vz *. b.mass
    }
    m := bodies[0].mass
    bodies[0].vx = neg(px) /. m
    bodies[0].vy = neg(py) /. m
    bodies[0].vz = neg(pz) /. m
}

fn energy(bodies: Vec[Body]) -> float {
    e := 0.0
    n := bodies.len()
    for i in 0..n {
        b := bodies[i]
        e +.= 0.5 *. b.mass *. (b.vx *. b.vx +. b.vy *. b.vy +. b.vz *. b.vz)
        for j in i + 1..n {
            c := bodies[j]
            dx := b.x -. c.x
            dy := b.y -. c.y
            dz := b.z -. c.z
            e -.= b.mass *. c.mass /. math.sqrt(dx *. dx +. dy *. dy +. dz *. dz)
        }
    }
    return e
}

fn advance(bodies: Vec[Body], dt: float) {
    n := bodies.len()
    for i in 0..n {
        b := bodies[i]
        for j in i + 1..n {
            c := bodies[j]
            dx := b.x -. c.x
            dy := b.y -. c.y
            dz := b.z -. c.z
            d2 := dx *. dx +. dy *. dy +. dz *. dz
            mag := dt /. (d2 *. math.sqrt(d2))
            b.vx -.= dx *. c.mass *. mag
            b.vy -.= dy *. c.mass *. mag
            b.vz -.= dz *. c.mass *. mag
            c.vx +.= dx *. b.mass *. mag
            c.vy +.= dy *. b.mass *. mag
            c.vz +.= dz *. b.mass *. mag
            bodies[j] = c
        }
        bodies[i] = b
    }
    for i in 0..n {
        b := bodies[i]
        b.x +.= dt *. b.vx
        b.y +.= dt *. b.vy
        b.z +.= dt *. b.vz
        bodies[i] = b
    }
}

fn main() {
    bodies := planets()
    offset_momentum(bodies)
    before := energy(bodies)
    for _i in 0..2000000 { advance(bodies, 0.01) }
    io.println(before.to_string().concat(" ").concat(energy(bodies).to_string()))
}
