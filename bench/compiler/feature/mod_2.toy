import std/vec
import std/map
import std/set
import std/str
import mod_1

pub protocol Score_2_0 { fn score(self) -> int }

pub struct Pair_2_0[T] { pub a: T, pub b: T }

impl Pair_2_0[T] {
    fn swap(self) -> Pair_2_0[T] { Pair_2_0 { a: self.b, b: self.a } }
    fn map[U](self, f: fn(T) -> U) -> Pair_2_0[U] { Pair_2_0 { a: f(self.a), b: f(self.b) } }
}

pub struct Item_2_0 { pub id: int, pub name: str }

impl Item_2_0 has Score_2_0 {
    fn score(self) -> int { self.id * 2 + self.name.len() }
}

impl Pair_2_0[T] has Score_2_0 {
    fn score(self) -> int { 0 + 1 }
}

pub enum Shape_2_0 { dot, circle(int), rect { w: int, h: int } }

fn area_2_0(sh: Shape_2_0) -> int {
    match sh {
        .dot -> 0,
        .circle(r) -> 3 * r * r,
        .rect { w, h } -> w * h,
    }
}

pub fn total_2_0[T has Score_2_0](xs: Vec[T]) -> int {
    xs.fold(0, fn(acc, x) { acc + x.score() })
}

fn or_default_2_0[T](o: Option[T], d: T) -> T {
    match o { .some(v) -> v, .none -> d }
}

fn parse_2_0(n: int) -> Result[int, str] {
    if n < 0 { return Result[int, str].err("negative") }
    return Result.ok(n + 0)
}

fn chain_2_0(n: int) -> Result[int, str] {
    a := parse_2_0(n)?
    b := parse_2_0(a)?
    return Result.ok(a + b)
}

fn first_even_2_0(xs: Vec[int]) -> Option[int] {
    for x in xs { if x % 2 == 0 { return Option.some(x) } }
    return Option.none
}

fn half_first_even_2_0(xs: Vec[int]) -> Option[int] {
    v := first_even_2_0(xs)?
    return Option.some(v / 2)
}

fn make_scaler_2_0(k: int) -> fn(int) -> int { fn(x) { x * k + 0 } }

pub fn run_2_0(n: int) -> int {
    items: Vec[Item_2_0] = []
    for i in 0..4 { items.push(Item_2_0 { id: i + n, name: "item".concat(i.to_string()) }) }
    seen := Set[Item_2_0].new()
    for it in items { seen.add(it) }
    seen.add(Item_2_0 { id: n, name: "item0" })
    scores := Map[str, int].new()
    for it in items { scores.set(it.name, it.score()) }
    ints := Pair_2_0 { a: n, b: 2 }.swap().map(make_scaler_2_0(3))
    lens := Pair_2_0 { a: "ab", b: "cde" }.map(fn(t) { t.len() })
    flags := Pair_2_0 { a: true, b: false }.map(fn(f) { if f { 1 } else { 0 } })
    pairs: Vec[Pair_2_0[int]] = [ints, lens, flags]
    shapes: Vec[Shape_2_0] = [Shape_2_0.dot, Shape_2_0.circle(n), Shape_2_0.rect { w: n, h: 0 + 1 }]
    area := area_2_0
    areas := shapes |> .map(area) |> .fold(0, fn(acc, x) { acc + x })
    evens := items |> .map(fn(it) { it.id }) |> .filter(fn(x) { x % 2 == 0 })
    label := Item_2_0 { id: 0, name: "x" }.to_string()
    probe := Item_2_0 { id: n, name: "item0" }
    same := if items[0] == probe { 1 } else { 0 }
    ok := match chain_2_0(n) { .ok(v) -> v, .err(_) -> 0 }
    return total_2_0(items) + total_2_0(pairs) + seen.len() + or_default_2_0(scores.get("item1"), 0) +
        areas + evens.len() + label.len() + same + ok + or_default_2_0(half_first_even_2_0(evens), 7)
}

fn upstream_2_0(n: int) -> int {
    xs: Vec[mod_1.Item_1_0] = [mod_1.Item_1_0 { id: n, name: "up" }]
    ys: Vec[mod_1.Pair_1_0[str]] = [mod_1.Pair_1_0 { a: "u", b: "v" }]
    return mod_1.total_1_0(xs) + mod_1.total_1_0(ys) + mod_1.run_1_0(n)
}

pub protocol Score_2_1 { fn score(self) -> int }

pub struct Pair_2_1[T] { pub a: T, pub b: T }

impl Pair_2_1[T] {
    fn swap(self) -> Pair_2_1[T] { Pair_2_1 { a: self.b, b: self.a } }
    fn map[U](self, f: fn(T) -> U) -> Pair_2_1[U] { Pair_2_1 { a: f(self.a), b: f(self.b) } }
}

pub struct Item_2_1 { pub id: int, pub name: str }

impl Item_2_1 has Score_2_1 {
    fn score(self) -> int { self.id * 2 + self.name.len() }
}

impl Pair_2_1[T] has Score_2_1 {
    fn score(self) -> int { 1 + 1 }
}

pub enum Shape_2_1 { dot, circle(int), rect { w: int, h: int } }

fn area_2_1(sh: Shape_2_1) -> int {
    match sh {
        .dot -> 0,
        .circle(r) -> 3 * r * r,
        .rect { w, h } -> w * h,
    }
}

pub fn total_2_1[T has Score_2_1](xs: Vec[T]) -> int {
    xs.fold(0, fn(acc, x) { acc + x.score() })
}

fn or_default_2_1[T](o: Option[T], d: T) -> T {
    match o { .some(v) -> v, .none -> d }
}

fn parse_2_1(n: int) -> Result[int, str] {
    if n < 0 { return Result[int, str].err("negative") }
    return Result.ok(n + 1)
}

fn chain_2_1(n: int) -> Result[int, str] {
    a := parse_2_1(n)?
    b := parse_2_1(a)?
    return Result.ok(a + b)
}

fn first_even_2_1(xs: Vec[int]) -> Option[int] {
    for x in xs { if x % 2 == 0 { return Option.some(x) } }
    return Option.none
}

fn half_first_even_2_1(xs: Vec[int]) -> Option[int] {
    v := first_even_2_1(xs)?
    return Option.some(v / 2)
}

fn make_scaler_2_1(k: int) -> fn(int) -> int { fn(x) { x * k + 1 } }

pub fn run_2_1(n: int) -> int {
    items: Vec[Item_2_1] = []
    for i in 0..4 { items.push(Item_2_1 { id: i + n, name: "item".concat(i.to_string()) }) }
    seen := Set[Item_2_1].new()
    for it in items { seen.add(it) }
    seen.add(Item_2_1 { id: n, name: "item0" })
    scores := Map[str, int].new()
    for it in items { scores.set(it.name, it.score()) }
    ints := Pair_2_1 { a: n, b: 2 }.swap().map(make_scaler_2_1(3))
    lens := Pair_2_1 { a: "ab", b: "cde" }.map(fn(t) { t.len() })
    flags := Pair_2_1 { a: true, b: false }.map(fn(f) { if f { 1 } else { 0 } })
    pairs: Vec[Pair_2_1[int]] = [ints, lens, flags]
    shapes: Vec[Shape_2_1] = [Shape_2_1.dot, Shape_2_1.circle(n), Shape_2_1.rect { w: n, h: 1 + 1 }]
    area := area_2_1
    areas := shapes |> .map(area) |> .fold(0, fn(acc, x) { acc + x })
    evens := items |> .map(fn(it) { it.id }) |> .filter(fn(x) { x % 2 == 0 })
    label := Item_2_1 { id: 1, name: "x" }.to_string()
    probe := Item_2_1 { id: n, name: "item0" }
    same := if items[0] == probe { 1 } else { 0 }
    ok := match chain_2_1(n) { .ok(v) -> v, .err(_) -> 0 }
    return total_2_1(items) + total_2_1(pairs) + seen.len() + or_default_2_1(scores.get("item1"), 0) +
        areas + evens.len() + label.len() + same + ok + or_default_2_1(half_first_even_2_1(evens), 7)
}

fn upstream_2_1(n: int) -> int {
    xs: Vec[mod_1.Item_1_1] = [mod_1.Item_1_1 { id: n, name: "up" }]
    ys: Vec[mod_1.Pair_1_1[str]] = [mod_1.Pair_1_1 { a: "u", b: "v" }]
    return mod_1.total_1_1(xs) + mod_1.total_1_1(ys) + mod_1.run_1_1(n)
}

pub fn entry(n: int) -> int {
    total := 0
    total += run_2_0(n) + upstream_2_0(n)
    total += run_2_1(n) + upstream_2_1(n)
    total += mod_1.entry(n)
    return total
}
