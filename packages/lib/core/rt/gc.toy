# The collector: a non-moving, stop-the-world mark-sweep over 16 KiB spans of size-class
# cells. Lowered code calls its entries, `alloc` (or `alloc_slow`, where `alloc` is spliced
# in) and `collect`. A call between core/rt fns is no safepoint: T0082 holds every core/rt
# fn but the entries to never reach the collector, so the collector gets its own memory
# from mmap, malloc and realloc.
#
# Every address here is an `int`. None is a reference the collector must keep alive, so no
# stack map names one.
#
# The roots are in the frames of the stopped program. A toy frame has a precise row in the
# stack map. A frame no toy fn owns (a hand-written builtin, or C calling back into toy) is
# scanned word by word: it is the only memory read without a layout.
#
# Every object is allocated with a layout: 0 for one that holds no reference,
# `container()` for a Vec or Map backing of references, `map_header()` for a Map header,
# else a layout program (`GcLayout` in the compiler) that names the offsets of its
# references. The layout picks the object's kind, and a span holds cells of one size class
# and one kind. A noscan or container cell is marked but never traced on its own (a
# backing's live elements are traced through its header), so its span records no layouts.
# A mixed span records each cell's layout in a table. A Vec header's program leads with
# `array_mark()` and the element size, then the element's program. A marked object is
# traced when it comes off the mark stack by running its program (`trace_cell`), or for a
# container header by running its element layouts over the live elements (`trace_vec`,
# `trace_map`). Only offsets are read, so the layouts would serve a moving collector too.
#
# The sweep is lazy: a collection only marks, then files each span, one with no marked cell
# in a pool any class refills from, every other one on its class's unswept list, which
# allocation sweeps a span at a time once the class's freelist runs dry.
#
# The control block is in the image's zero-fill __bss, so every field starts at 0. A span
# is a 256-byte header, the layout table if it is mixed, then cells of one size, carved
# from a 64 MiB arena; a large object (over 8 KiB) has a mapping of its own with the same
# header shape. The page map names the span or large object that owns each heap page. The
# fns at the end name each field's offset.

extern fn mmap(addr: int, len: int, prot: int, flags: int, fd: int, off: int) -> int
extern fn munmap(addr: int, len: int) -> int
extern fn malloc(n: int) -> int
extern fn realloc(p: int, n: int) -> int
extern fn memset(p: int, c: int, n: int) -> int

# A fresh zeroed cell of at least `size` bytes, traced by `layout`: 0, `container()`,
# `map_header()` or the address of a layout program. Every caller built with the inliner
# takes this body spliced in (#211), so the fast path costs no call, and the size and
# layout it is passed fold, the kind with them: it takes a cell of the first four classes,
# which step by 16 bytes, off its freelist, and only a mixed cell writes its layout. Every
# other case calls `alloc_slow`.
pub fn alloc(size: int, layout: int) -> rawptr {
    if size <= 64 && !gc_stress() {
        cb := control_block()
        class := 0
        if size > 16 { class = (size - 1) / 16 }
        kind := kind_of(layout)
        head := freelist(cb, kind + class)
        cell := word(head)
        if cell != 0 {
            set_word(head, word(cell))
            set_word(cell, 0)
            if kind == mixed() { set_layout(cell, relative(layout)) }
            return offset(cell, 0)
        }
    }
    return alloc_slow(size, layout)
}

# The second collector entry, called from wherever `alloc` was spliced. It reads its own
# frame record, whose return address is in that caller: the stack walk starts there.
pub fn alloc_slow(size: int, layout: int) -> rawptr {
    cb := control_block()
    fp := frame_address()
    kind := kind_of(layout)
    rel := 0
    if kind == mixed() { rel = relative(layout) }
    # The collection resets the allocation count, so the budget below never also fires: a
    # stress run collects exactly once per allocation.
    if gc_stress() { collect_from(cb, fp) }
    if size > 8192 {
        obj := alloc_large(cb, size, fp)
        set_word(large_layout(obj - 256), rel)
        return offset(obj, 0)
    }
    class := size_class(size)
    list := kind + class
    head := freelist(cb, list)
    cell := word(head)
    if cell == 0 {
        cell = sweep_list(cb, list)
        if cell == 0 && over_budget(cb) {
            collect_from(cb, fp)
            cell = sweep_list(cb, list)
        }
        if cell == 0 { cell = refill(cb, list, class_size(class), kind) }
    }
    set_word(head, word(cell))
    set_word(cell, 0)
    if kind == mixed() { set_layout(cell, rel) }
    return offset(cell, 0)
}

# Run a collection now.
pub fn collect() {
    collect_from(control_block(), frame_address())
}

pub fn collections() -> int {
    return word(collections_run(control_block()))
}

pub fn span_count() -> int {
    return word(spans_mapped(control_block()))
}

# The size classes, as `Abi.size_classes` lists them: the first that holds `size`.
fn size_class(size: int) -> int {
    if size <= 16 { return 0 }
    if size <= 32 { return 1 }
    if size <= 48 { return 2 }
    if size <= 64 { return 3 }
    if size <= 96 { return 4 }
    if size <= 128 { return 5 }
    if size <= 192 { return 6 }
    if size <= 256 { return 7 }
    if size <= 512 { return 8 }
    if size <= 1024 { return 9 }
    if size <= 2048 { return 10 }
    if size <= 4096 { return 11 }
    return 12
}

fn class_size(class: int) -> int {
    if class < 4 { return (class + 1) * 16 }
    if class == 4 { return 96 }
    if class == 5 { return 128 }
    if class == 6 { return 192 }
    return 256 << (class - 7)
}

# The span kinds, each named by the first of its span lists (a freelist and an unswept list
# for each size class), so a kind plus a class is a list with no multiply. A noscan cell
# holds no reference; a container cell is a Vec or Map backing whose references its header
# traces; a mixed cell is traced by the layout its span records for it. Container and
# noscan cells are handled alike today, but only a noscan cell may be skipped by a
# collector that has to find every reference, such as a moving one.
fn noscan() -> int { return 0 }
fn mixed() -> int { return class_count() }
fn container_kind() -> int { return 2 * class_count() }
fn list_count() -> int { return 3 * class_count() }

fn class_count() -> int { return 13 }

# The layout a Vec or Map backing of references is allocated with, as `core/mem`'s
# `container` gives it. Like `map_header()`, it is below any layout program's address.
fn container() -> int { return 2 }

# Most layouts that do not fold are programs, which the first test settles.
fn kind_of(layout: int) -> int {
    if layout > container() { return mixed() }
    if layout == 0 { return noscan() }
    if layout == container() { return container_kind() }
    # `map_header()`: a Map header is traced by its own walk, and only a mixed span keeps
    # the layout that names it.
    return mixed()
}

# Go's GOGC=100 pacing: collect once the program has allocated as much as the last sweep
# kept, but never before 4 MiB, Go's minimum heap. A fixed budget would make a growing live
# set pay a whole-heap trace every few hundred KiB, and a lower floor made a small heap
# collect 16 times as often: alloc ran 17% more instructions with a 256 KiB floor.
fn over_budget(cb: int) -> bool {
    budget := word(kept(cb))
    if budget < 4194304 { budget = 4194304 }
    return word(allocated(cb)) >= budget
}

# A failed mapping (MAP_FAILED, -1) would put the page map, an arena or a large object at
# address -1, where the next write lands far from any mapping, so it panics here instead.
fn map_pages(len: int) -> int {
    at := unsafe { mmap(0, len, 3, 4098, -1, 0) }
    if at == -1 { panic("out of memory") }
    return at
}

# Sweep the list's unswept spans until one frees a cell. Returns the freelist head.
fn sweep_list(cb: int, list: int) -> int {
    head := freelist(cb, list)
    while word(head) == 0 && sweep_next(cb, list) {}
    return word(head)
}

# Sweep the next of the list's unswept spans. False when none is left.
fn sweep_next(cb: int, list: int) -> bool {
    at := unswept(cb, list)
    span := word(at)
    if span == 0 { return false }
    set_word(at, word(span_link(span)))
    sweep_span(cb, span)
    return true
}

# Give span list `list` a span of `kind`, an empty one if a collection found any, else a
# new mapping, and put its cells on the list's freelist. Returns the freelist head.
fn refill(cb: int, list: int, cell_size: int, kind: int) -> int {
    span := word(span_pool(cb))
    if span != 0 {
        set_word(span_pool(cb), word(span_link(span)))
        # Its cells died unswept, and its layout entries, if it was mixed, were written for
        # another class's cell boundaries.
        unsafe { memset(span + 256, 0, 16384 - 256) }
    } else {
        span = new_span(cb)
        set_pages(cb, span, 16384, span)
        set_word(span, word(span_list(cb)))
        set_word(span_list(cb), span)
        set_word(spans_mapped(cb), word(spans_mapped(cb)) + 1)
    }
    first := first_cell(kind)
    count := (16384 - first) / cell_size
    set_word(allocated(cb), word(allocated(cb)) + count * cell_size)
    set_word(span_cell_size(span), cell_size)
    set_word(span_cell_count(span), count)
    set_word(span_cells(span), span + first)
    set_word(span_list_of(span), list)
    set_word(span_kind(span), kind)
    head := freelist(cb, list)
    i := 0
    while i < count {
        cell := span + first + i * cell_size
        set_word(cell, word(head))
        set_word(head, cell)
        i += 1
    }
    return word(head)
}

# A large object has no freelist to run dry, so the allocation budget is its only trigger.
# The collection runs before the mapping, so the new object is never at risk.
fn alloc_large(cb: int, size: int, fp: int) -> int {
    if over_budget(cb) { collect_from(cb, fp) }
    len := (size + 256 + 16383) / 16384 * 16384
    obj := map_pages(len)
    add_heap(cb, obj, len)
    set_pages(cb, obj, len, obj)
    set_word(obj, word(large_list(cb)))
    set_word(large_list(cb), obj)
    set_word(large_size(obj), size)
    set_word(span_cells(obj), obj + 256)
    set_word(large_len(obj), len)
    set_word(spans_mapped(cb), word(spans_mapped(cb)) + 1)
    set_word(allocated(cb), word(allocated(cb)) + size)
    return obj + 256
}

# The next 16 KiB of the current arena, or of a new one once it is used up. An arena costs
# one mmap for 4096 spans, and the kernel commits its pages only as they are written.
fn new_span(cb: int) -> int {
    span := word(arena_next(cb))
    if span == word(arena_end(cb)) {
        span = map_pages(arena_size())
        add_heap(cb, span, arena_size())
        set_word(arena_end(cb), span + arena_size())
    }
    set_word(arena_next(cb), span + 16384)
    return span
}

fn arena_size() -> int { return 67108864 }

# Widen the heap's bounds to cover a new mapping, mapping the page map first. The map has a
# word for each 16 KiB page below 2^47, macOS's user address space, so it needs no base and
# no second level wherever the kernel puts an arena or a large object. Its 64 GiB are
# reserved, not committed: a page of the map is resident only once a word in the 32 MiB of
# address space it covers has been looked up. The bounds keep any other word off the map.
fn add_heap(cb: int, at: int, len: int) {
    if word(page_map(cb)) == 0 {
        set_word(page_map(cb), map_pages(68719476736))
        set_word(heap_low(cb), at)
    }
    if at < word(heap_low(cb)) { set_word(heap_low(cb), at) }
    if at + len > word(heap_high(cb)) { set_word(heap_high(cb), at + len) }
}

# Point the page map entry of every page of [at, at + len) at `owner`, or 0 for none.
fn set_pages(cb: int, at: int, len: int, owner: int) {
    entry := word(page_map(cb)) + (at >> 14) * 8
    end := entry + (len >> 14) * 8
    while entry < end {
        set_word(entry, owner)
        entry += 8
    }
}

# One collection. `fp` is the frame record of the entry the program called, so the walk
# starts at the program's frame: the collector's own frames hold no roots.
fn collect_from(cb: int, fp: int) {
    if word(mark_cap(cb)) == 0 {
        set_word(mark_stack(cb), unsafe { malloc(4096 * 16) })
        set_word(mark_cap(cb), 4096)
    }
    set_word(mark_len(cb), 0)
    # A span the last cycle left unswept still holds its dead objects whole, and a stale
    # root that marked one would trace pointers into memory since freed or unmapped. Its
    # sweep zeroes them and clears its marks. Its free cells, like every class's, are found
    # again by the sweep after this collection.
    list := 0
    while list < list_count() {
        while sweep_next(cb, list) {}
        set_word(freelist(cb, list), 0)
        list += 1
    }
    scan_stack(fp)
    drain(cb)
    live := file_spans(cb) + sweep_large(cb)
    set_word(collections_run(cb), word(collections_run(cb)) + 1)
    set_word(allocated(cb), 0)
    set_word(kept(cb), live)
}

# Mark the object `w` points into, if it is a heap object, and push it to be traced if it
# is mixed and holds a reference. Any word may come here, so `w` is checked against
# the heap before anything reads through it: a word that only looks like a pointer keeps an
# object alive, and nothing worse. Each reference an object holds comes through here, so
# the push is written out in place, and the one call left, to grow the mark stack, comes
# last: nothing is live across a call, so no register is saved.
fn mark_word(w: int) {
    cb := control_block()
    if w < word(heap_low(cb)) || w >= word(heap_high(cb)) { return }
    span := word(word(page_map(cb)) + (w >> 14) * 8)
    if span == 0 { return }
    obj := word(span_cells(span))
    size := word(span_cell_size(span))
    layout := 0
    if size == 0 {
        if w < obj || w >= obj + word(large_size(span)) || word(large_mark(span)) != 0 { return }
        set_word(large_mark(span), 1)
        layout = word(large_layout(span))
    } else {
        if w < obj { return }
        cell := (w - obj) / size
        if cell >= word(span_cell_count(span)) { return }
        at := span_marks(span) + cell / 8
        bit := 1 << (cell & 7)
        bits := byte(at)
        if (bits & bit) != 0 { return }
        set_byte(at, bits | bit)
        if word(span_kind(span)) != mixed() { return }
        obj = obj + cell * size
        layout = low_half(word(layout_slot(obj)))
    }
    if layout == 0 { return }
    n := word(mark_len(cb))
    if n == word(mark_cap(cb)) {
        grow_and_push(obj, layout)
        return
    }
    entry := word(mark_stack(cb)) + n * 16
    set_word(entry, obj)
    set_word(entry + 8, layout)
    set_word(mark_len(cb), n + 1)
}

fn grow_and_push(obj: int, layout: int) {
    cb := control_block()
    n := word(mark_len(cb))
    set_word(mark_stack(cb), unsafe { realloc(word(mark_stack(cb)), n * 32) })
    set_word(mark_cap(cb), n * 2)
    entry := word(mark_stack(cb)) + n * 16
    set_word(entry, obj)
    set_word(entry + 8, layout)
    set_word(mark_len(cb), n + 1)
}

# Walk the frame chain from the entry's frame `fp` out to the first frame. The return
# address a frame saved names its caller's fn, whose stack-map row names the caller's roots
# at that call.
fn scan_stack(fp: int) {
    text := text_base()
    map := stack_map()
    rows := word(map)
    frame := fp
    loop {
        caller := word(frame)
        # A caller's frame is above its callee's, so this, unlike a frame count, ends a
        # corrupt chain without cutting off a deep live one.
        if caller <= frame { return }
        roots := frame_roots(map, rows, word(frame + 8) - 4 - text)
        # The count is 4 bytes; the load's other half is the next 4 bytes of the table.
        n := low_half(word(roots))
        sp := frame + 16
        if n == unmapped_frame() {
            scan_words(sp, caller)
        } else {
            scan_roots(roots + 4, n, sp)
        }
        frame = caller
    }
}

# The stack-map payload for code at text offset `at`: that of the last row at or before
# it. The table is `[count][{off, payload offset} x count][payloads]`, rows ascending, the
# first at 0 and the last a sentinel at the end of __text that marks a frame for a word
# scan. Code outside __text (C) gets the sentinel.
fn frame_roots(map: int, rows: int, at: int) -> int {
    if at < 0 { return map + word(map + rows * 16) }
    low := 0
    high := rows
    while high - low > 1 {
        mid := (low + high) / 2
        if word(map + 8 + mid * 16) <= at { low = mid } else { high = mid }
    }
    return map + word(map + 16 + low * 16)
}

# Each root of a precise row is a u32 sp offset.
fn scan_roots(at: int, n: int, sp: int) {
    i := 0
    while i < n {
        mark_word(word(sp + low_half(word(at + i * 4))))
        i += 1
    }
}

# A frame no toy fn owns, word by word. Most words are no pointer, so each is checked
# against the heap's bounds before the call that would look it up.
fn scan_words(from: int, to: int) {
    cb := control_block()
    low := word(heap_low(cb))
    high := word(heap_high(cb))
    at := from
    while at < to {
        w := word(at)
        if w >= low && w < high { mark_word(w) }
        at += 8
    }
}

# Trace every marked object to a fixpoint.
fn drain(cb: int) {
    map := stack_map()
    loop {
        n := word(mark_len(cb))
        if n == 0 { return }
        n -= 1
        set_word(mark_len(cb), n)
        entry := word(mark_stack(cb)) + n * 16
        obj := word(entry)
        layout := word(entry + 8)
        if layout == map_header() {
            trace_map(obj)
        } else {
            prog := map + ((layout << 32) >> 32)
            if (word(prog) & 7) == array_mark() { trace_vec(obj, prog) } else { trace_cell(prog, obj) }
        }
    }
}

# Run layout program `prog` over the cell at `base`. Its words are `GcLayout`'s: the low
# 2 bits the op, the rest its argument. END 0; PTR 1 marks the reference at an offset;
# SWITCH 2 reads the enum tag at an offset and continues at the word index the next words
# give that tag; JUMP 3 continues at a word index.
fn trace_cell(prog: int, base: int) {
    i := 0
    loop {
        w := word(prog + i * 8)
        op := w & 3
        if op == 1 {
            mark_word(word(base + (w >> 2)))
            i += 1
        } else if op == 2 {
            tag := word(base + (w >> 2))
            # A free cell keeps its last layout and only its freelist link, which a tag at
            # offset 0 would read: a stale root may lead here, and must not jump wild.
            if tag < 0 || tag >= word(prog + i * 8 + 8) { return }
            i = word(prog + (i + 2 + tag) * 8)
        } else if op == 3 {
            i = w >> 2
        } else {
            return
        }
    }
}

# A Vec header: {len@0, elems@16}, and its program `array`: {array_mark | size << 3, the
# element's program}. The backing has no layout of its own: only its first `len` elements
# are live, and each runs the element's program, if the element type holds a reference.
fn trace_vec(header: int, array: int) {
    elems := word(header + 16)
    # An empty Vec has no backing. So has a free header, which keeps its layout and only its
    # freelist link, in `len`: a stale root may lead here, and must not walk that many.
    if elems == 0 { return }
    mark_word(elems)
    prog := array + 8
    if word(prog) == 0 { return }
    len := word(header)
    size := word(array) >> 3
    i := 0
    # Most element types hold one reference (a str, a Ref, a closure's env), so a program of
    # one PTR is run in place rather than called per element.
    one := word(prog)
    if (one & 3) == 1 && word(prog + 8) == 0 {
        at := elems + (one >> 2)
        while i < len {
            mark_word(word(at + i * size))
            i += 1
        }
        return
    }
    while i < len {
        trace_cell(prog, elems + i * size)
        i += 1
    }
}

# A Map or Set header: {buckets@0, entries@8, len@24, key_layout@32, val_layout@40,
# key_size@48, stride@56}. The entries are dense in insertion order, so the walk sees every
# live entry wherever its bucket probed to, and a key's buffer is reached only through it.
fn trace_map(header: int) {
    mark_word(word(header))
    entries := word(header + 8)
    mark_word(entries)
    keys := word(header + 32)
    values := word(header + 40)
    if keys == 0 && values == 0 { return }
    len := word(header + 24)
    stride := word(header + 56)
    key_size := word(header + 48)
    i := 0
    while i < len {
        entry := entries + i * stride
        if keys != 0 { trace_cell(keys, entry) }
        if values != 0 { trace_cell(values, entry + key_size) }
        i += 1
    }
}

# After marking, put each span with no marked cell in the pool for any class to take, and
# leave every other one on its class's unswept list, to be swept when the class runs out of
# cells: the sweep writes each dead cell just before the program takes it, rather than every
# dead cell of the heap at once and again on allocation. A pooled span has a cell count of
# 0, so no word marks into its dead cells. Pooled spans stay mapped: unmapping those past
# the next cycle's budget cost binary_trees 7% in mmap churn and no peak RSS. Returns the
# bytes kept.
fn file_spans(cb: int) -> int {
    live := 0
    set_word(span_pool(cb), 0)
    span := word(span_list(cb))
    while span != 0 {
        count := word(span_cell_count(span))
        marked := 0
        if count != 0 { marked = marked_cells(span, count) }
        if marked == 0 {
            set_word(span_cell_count(span), 0)
            set_word(span_link(span), word(span_pool(cb)))
            set_word(span_pool(cb), span)
        } else {
            live += marked * word(span_cell_size(span))
            set_word(span_live(span), marked)
            list := unswept(cb, word(span_list_of(span)))
            set_word(span_link(span), word(list))
            set_word(list, span)
        }
        span = word(span)
    }
    return live
}

# The mark bits set in a span, a word of them at a time (SWAR popcount). The bits past the
# last cell are never set, and the last word ends before `span_link`.
fn marked_cells(span: int, count: int) -> int {
    n := 0
    at := span_marks(span)
    end := at + (count + 63) / 64 * 8
    while at < end {
        x := word(at)
        if x != 0 {
            x = x -% ((x >> 1) & 0x5555_5555_5555_5555)
            x = (x & 0x3333_3333_3333_3333) + ((x >> 2) & 0x3333_3333_3333_3333)
            x = (x + (x >> 4)) & 0x0F0F_0F0F_0F0F_0F0F
            n += (x *% 0x0101_0101_0101_0101) >> 56
        }
        at += 8
    }
    return n
}

# Free every unmarked cell of `span` onto its class's freelist, zeroed for the next `alloc`,
# and clear the marks.
fn sweep_span(cb: int, span: int) {
    size := word(span_cell_size(span))
    count := word(span_cell_count(span))
    cells := word(span_cells(span))
    head := freelist(cb, word(span_list_of(span)))
    # A byte of mark bits at a time: its 8 cells, then the byte cleared whole.
    at := span_marks(span)
    i := 0
    while i < count {
        bits := byte(at)
        bit := 1
        while bit < 256 && i < count {
            if (bits & bit) == 0 {
                cell := cells + i * size
                # Word 0 becomes the freelist link.
                k := 8
                while k < size {
                    set_word(cell + k, 0)
                    k += 8
                }
                set_word(cell, word(head))
                set_word(head, cell)
            }
            bit += bit
            i += 1
        }
        set_byte(at, 0)
        at += 1
    }
    set_word(allocated(cb), word(allocated(cb)) + (count - word(span_live(span))) * size)
}

# Unmap every unmarked large object and clear the marks. Returns the bytes kept.
fn sweep_large(cb: int) -> int {
    live := 0
    # The word that points at `obj`: the list head, or the previous object's next field.
    link := large_list(cb)
    obj := word(link)
    while obj != 0 {
        next := word(obj)
        if word(large_mark(obj)) != 0 {
            set_word(large_mark(obj), 0)
            live += word(large_size(obj))
            link = obj
        } else {
            set_word(link, next)
            set_pages(cb, obj, word(large_len(obj)), 0)
            unsafe { munmap(obj, word(large_len(obj))) }
        }
        obj = next
    }
    return live
}

# Control block fields. Release inlines each, so a name costs no call. Byte 232 is
# core/rt/stack's: 1 once it has armed the stack overflow handler.
fn spans_mapped(cb: int) -> int { return cb }
fn collections_run(cb: int) -> int { return cb + 8 }
# Bytes allocated since the last collection, counted when a refill or a sweep hands a
# span's free cells to a freelist rather than per cell taken, which keeps the count off the
# fast path.
fn allocated(cb: int) -> int { return cb + 16 }
fn span_list(cb: int) -> int { return cb + 24 }
fn large_list(cb: int) -> int { return cb + 32 }
# {object, layout} entries of 16 bytes.
fn mark_stack(cb: int) -> int { return cb + 40 }
fn mark_len(cb: int) -> int { return cb + 48 }
fn mark_cap(cb: int) -> int { return cb + 56 }
# Bytes the last sweep kept, which pace the next collection.
fn kept(cb: int) -> int { return cb + 64 }
fn page_map(cb: int) -> int { return cb + 72 }
# The bump cursor and end of the arena new spans are carved from.
fn arena_next(cb: int) -> int { return cb + 80 }
fn arena_end(cb: int) -> int { return cb + 88 }
# The lowest and highest heap addresses ever mapped. A word between them may still be on
# no page the map names.
fn heap_low(cb: int) -> int { return cb + 96 }
fn heap_high(cb: int) -> int { return cb + 104 }
# The head of the spans the last collection found empty.
fn span_pool(cb: int) -> int { return cb + 112 }
# A head for each span list.
fn freelist(cb: int, list: int) -> int { return cb + 240 + list * 8 }
# A head for each span list of the spans marked by the last collection and not yet swept.
fn unswept(cb: int, list: int) -> int { return cb + 552 + list * 8 }

# Span header fields; word 0 links the next span. A large object's header has a cell size
# of 0, and its own fields at 16, 32, 40 and 48.
fn span_cell_size(span: int) -> int { return span + 8 }
fn span_cell_count(span: int) -> int { return span + 16 }
fn span_cells(span: int) -> int { return span + 24 }
fn span_list_of(span: int) -> int { return span + 32 }
fn span_kind(span: int) -> int { return span + 40 }
# A bit per cell: 1008 of the smallest in a span with no layout table.
fn span_marks(span: int) -> int { return span + 48 }
# Links the span into an unswept list or the pool; past the most mark bits a span has.
fn span_link(span: int) -> int { return span + 176 }
# The cells the last collection marked, which the span's sweep does not hand out.
fn span_live(span: int) -> int { return span + 184 }
fn large_size(obj: int) -> int { return obj + 16 }
fn large_len(obj: int) -> int { return obj + 32 }
fn large_mark(obj: int) -> int { return obj + 40 }
fn large_layout(obj: int) -> int { return obj + 48 }

# A mixed span's layout table follows its header: 4 bytes per 16 bytes of cells, the size
# of the smallest class, so alloc finds a cell's entry from its address alone, with no
# divide by the class size (mark divides anyway, for the mark bit). A mixed span holds 806
# such cells; the first is past the table and 8 bytes of slack, which `set_layout` writes
# into. Any other span's cells start right after the header.
fn first_cell(kind: int) -> int {
    if kind == mixed() { return table_end() }
    return 256
}

fn table_end() -> int { return 3488 }

fn layout_slot(cell: int) -> int {
    off := cell & 16383
    return cell - off + (off >> 2) + (256 - (table_end() >> 2))
}

fn set_layout(cell: int, rel: int) {
    unsafe { store_u32(layout_slot(cell), rel) }
}

# The 4-byte entry of `layout`. A program is kept as its offset from the stack map, which
# the image lays out after every literal: negative, so its low half is never 0 or
# `map_header()`. `stack_map()` is an address the code forms in place, where `text_base()`
# is a call.
fn relative(layout: int) -> int {
    if layout > map_header() { return (layout - stack_map()) & 4294967295 }
    return layout
}

# The layout of a Map header, `core/mem`'s `map_header`.
fn map_header() -> int { return 1 }

# The low 3 bits of a Vec header program's first word: END as an op, so no cell program
# starts with it.
fn array_mark() -> int { return 4 }

# A stack-map count or root packs a u32 in a word's low half. The sentinel row's count
# marks a frame no toy fn owns.
fn low_half(w: int) -> int { return w & 4294967295 }
fn unmapped_frame() -> int { return 4294967295 }

fn word(at: int) -> int {
    return unsafe { load(at) }
}

fn set_word(at: int, v: int) {
    unsafe { store(at, v) }
}

fn byte(at: int) -> int {
    return unsafe { load_byte(at) }
}

fn set_byte(at: int, v: int) {
    unsafe { store_byte(at, v) }
}
