# A growable, traced array primitive: the ONE growable container. The handle is an
# 8-byte reference (`gc_array[T]`, a reused native box) pointing at a 24-byte heap header
# `{len@0, cap@8, elems@16}` addressed by literal offsets. The element backing lives at
# `elems`, each element at `elems + i*size_of[T]()`. `:=` copies the handle, so two
# bindings share the same growable (mutation through one is seen through the other).
# `ga_grow` leaks the old backing to the collector.
#
# The header is allocated with `array_layout_of[T]()`, a static per-type layout that holds
# the element size and the element type's layout: the erased collector, which sees only a
# structurally-identical `gc_array` handle, traces the live elements by it. The backing has
# no layout of its own: only the header knows how many elements are live.

# An empty array has no backing (`cap` and `elems` are born 0, as cells are zeroed): many
# Vecs stay empty, and the first push allocates.
pub fn ga_new[T]() -> gc_array[T] {
    return gc_array[T](gc_alloc(24, array_layout_of[T]()))
}

# `ga_new` with room for exactly `n` elements, for a caller that knows its final length.
# Up to 40 bytes of elements sit in the header's own cell, so a small literal is one
# allocation of at most 64 bytes; `elems` then points into that cell, which the collector
# marks through it as through any interior pointer. A grow moves them out for good. A
# negative `n` asks for no room, or the inline cell would be smaller than the header.
pub fn ga_with_cap[T](n: int) -> gc_array[T] {
    if n <= 0 { return ga_new[T]() }
    bytes := n * size_of[T]()
    if bytes <= 40 {
        hdr := gc_alloc(24 + bytes, array_layout_of[T]())
        unsafe {
            store(offset(hdr, 16), offset(hdr, 24))
            store(offset(hdr, 8), n)
        }
        return gc_array[T](hdr)
    }
    hdr := gc_alloc(24, array_layout_of[T]())
    unsafe {
        store(offset(hdr, 16), gc_alloc(bytes, 0))
        store(offset(hdr, 8), n)
    }
    return gc_array[T](hdr)
}

pub fn ga_len[T](a: gc_array[T]) -> int {
    return unsafe { load(offset(a, 0)) }
}

pub fn ga_get[T](a: gc_array[T], i: int) -> T {
    e := unsafe { load(offset(a, 16)) }
    return unsafe { load(offset(e, i * size_of[T]())) }
}

# Bounds-checked read: the sole element-access contract `xs[i]` desugars to, so the
# header offsets and element stride live only here. A signed `i < 0 || i >= len` catches
# both a negative index and an over-length one before the unchecked `ga_get` read.
pub fn ga_at[T](a: gc_array[T], i: int) -> T {
    if i < 0 || i >= ga_len[T](a) {
        panic("index out of bounds")
    }
    return ga_get[T](a, i)
}

# Unchecked element write; the caller keeps `i < len`.
pub fn ga_set[T](a: gc_array[T], i: int, x: T) {
    e := unsafe { load(offset(a, 16)) }
    unsafe { store(offset(e, i * size_of[T]()), x) }
}

# Bounds-checked write, the one `xs[i] = v` desugars to: the same check as `ga_at`, so a
# store can never land past `len` in the spare capacity a later push would expose.
pub fn ga_set_at[T](a: gc_array[T], i: int, x: T) {
    if i < 0 || i >= ga_len[T](a) {
        panic("index out of bounds")
    }
    ga_set[T](a, i, x)
}

pub fn ga_push[T](a: gc_array[T], x: T) {
    l := unsafe { load(offset(a, 0)) }
    c := unsafe { load(offset(a, 8)) }
    if l == c { ga_grow[T](a, c) }
    e := unsafe { load(offset(a, 16)) }
    unsafe {
        store(offset(e, l * size_of[T]()), x)
        store(offset(a, 0), l + 1)
    }
}

extern fn memcpy(dst: rawptr, src: rawptr, n: int) -> rawptr

# Double the backing (an empty one, which has none to copy, gets room for 4) and copy the
# live prefix over. A collection can fire inside `gc_alloc`, so the header still holds the
# OLD backing there (keeping its elements traced); nothing allocates between the copy and
# the publish. The header never moves, so every alias sees the new backing. libSystem's
# `memcpy` moves the bytes in bulk: a toy loop costs dozens of instructions per element.
pub fn ga_grow[T](a: gc_array[T], c: int) {
    nc := if c == 0 { 4 } else { c * 2 }
    ne := gc_alloc(nc * size_of[T](), 0)
    e: rawptr = unsafe { load(offset(a, 16)) }
    unsafe {
        store(offset(a, 16), ne)
        store(offset(a, 8), nc)
    }
    if c > 0 { unsafe { memcpy(ne, e, c * size_of[T]()) } }
}

# The layout a Map header is allocated with: core/rt/gc's `map_header`, which walks the
# entries by the header's own fields. No layout program is at address 1.
fn map_header() -> int {
    return 1
}

# An erased open-addressing hash table: the ONE hashed container. The 8-byte handle
# (`gc_array[int]`, a reused native box) points at a header {buckets@0, entries@8,
# cap@16, len@24}, followed by the trace stash {key_layout@32, val_layout@40,
# key_size@48, stride@56} the erased collector reads to trace live entries precisely.
# `buckets` is a `cap`-slot int array mapping a hash bucket to
# `entry_index+1` (0 == EMPTY, free because cells are zeroed on alloc); `entries` is a
# `cap`-cell DENSE array in INSERTION ORDER, each cell {key@0, val@size_of[K]}. Iteration
# walks entries[0..len) directly, so hash order can never reach program output. `cap` is a
# power of two so `hash & (cap-1)` masks the (possibly negative) hash into range without a
# sign fix. `:=` copies the handle, so two bindings share the one header. Cells are packed
# with no alignment padding (stride = size_of[K] + size_of[V]), so a sub-8-byte scalar key
# like bool leaves later cells unaligned. `V` may be zero-sized (`()`, as in `Set`): the
# stride is then `size_of[K] + 0` and the value store/load are no-ops. An owned (heap-backed)
# `str` key stores its `ptr` at the cell's key offset; the collector reaches it by walking
# entries[0..len) and running the K layout over each key (the entries backing has no
# layout of its own), so a scalar/static-pointer key needs no reach.
pub fn mp_new[K, V]() -> gc_array[int] {
    hdr := gc_alloc(64, map_header())
    unsafe {
        store(offset(hdr, 16), 8)
        store(offset(hdr, 32), layout_of[K]())
        store(offset(hdr, 40), layout_of[V]())
        store(offset(hdr, 48), size_of[K]())
        store(offset(hdr, 56), size_of[K]() + size_of[V]())
        store(offset(hdr, 0), gc_alloc(8 * 8, 0))
        store(offset(hdr, 8), gc_alloc(8 * (size_of[K]() + size_of[V]()), 0))
    }
    return gc_array[int](hdr)
}

pub fn mp_len[K, V](m: gc_array[int]) -> int {
    return unsafe { load(offset(m, 24)) }
}

pub fn mp_key_at[K, V](m: gc_array[int], i: int) -> K {
    stride := size_of[K]() + size_of[V]()
    entries := unsafe { load(offset(m, 8)) }
    return unsafe { load(offset(entries, i * stride)) }
}

pub fn mp_val_at[K, V](m: gc_array[int], i: int) -> V {
    stride := size_of[K]() + size_of[V]()
    entries := unsafe { load(offset(m, 8)) }
    return unsafe { load(offset(entries, i * stride + size_of[K]())) }
}

# The erased probe: the ONE place the key's hash/eq are consumed, via the key descriptor's
# function offsets resolved off text_base and call_indirect'd on raw key bytes (the exact
# desc_selftest pattern). Returns the entry index of `k`, or -1 when absent. The face's `has
# Hashable` bound rejects a non-Hashable key at compile time, but a bundled module (or a dev
# build's --dev-core-imports self-check) reaches these unbounded functions directly; a key with
# no hash/eq (offset 24/32 zero) would `call_indirect` into text_base and jump wild, so the
# guard turns that into a clean panic.
# The bound cannot move here: the raw `load`-into-`K` idiom needs a monomorphized (concrete)
# K, which a bound's abstract-template checking forbids. Guarding inside these generic bodies
# (not a shared non-generic helper) keeps the emit demand-driven, so no non-Map program shifts.
pub fn mp_find[K, V](m: gc_array[int], k: K) -> int {
    dp := descriptor_of[K]()
    return unsafe {
        ho := load(offset(dp, 24))
        eo := load(offset(dp, 32))
        if ho == 0 || eo == 0 { panic("key type is not Hashable") }
        fh := offset(text_base(), ho)
        fe := offset(text_base(), eo)
        stride := size_of[K]() + size_of[V]()
        qk := gc_alloc(size_of[K](), layout_of[K]())
        store(qk, k)
        cap := load(offset(m, 16))
        buckets := load(offset(m, 0))
        entries := load(offset(m, 8))
        mask := cap - 1
        i := call_hash(fh, qk) & mask
        loop {
            slot := load(offset(buckets, i * 8))
            if slot == 0 { return -1 }
            ei := slot - 1
            if call_eq(fe, offset(entries, ei * stride), qk) { return ei }
            i = (i + 1) & mask
        }
    }
}

# Insert or update. A miss appends a new entry (extending insertion order); a hit rewrites
# the value in place and leaves the index untouched, so a repeated key is iterated once at
# its ORIGINAL position. Grows at load factor 0.75, AFTER the append, so a probe always
# finds an EMPTY slot (the loop terminates).
pub fn mp_set[K, V](m: gc_array[int], k: K, v: V) {
    dp := descriptor_of[K]()
    unsafe {
        ho := load(offset(dp, 24))
        eo := load(offset(dp, 32))
        if ho == 0 || eo == 0 { panic("key type is not Hashable") }
        fh := offset(text_base(), ho)
        fe := offset(text_base(), eo)
        stride := size_of[K]() + size_of[V]()
        qk := gc_alloc(size_of[K](), layout_of[K]())
        store(qk, k)
        cap := load(offset(m, 16))
        buckets := load(offset(m, 0))
        entries := load(offset(m, 8))
        mask := cap - 1
        i := call_hash(fh, qk) & mask
        loop {
            slot := load(offset(buckets, i * 8))
            if slot == 0 {
                ei := load(offset(m, 24))
                cell := offset(entries, ei * stride)
                store(cell, k)
                store(offset(cell, size_of[K]()), v)
                store(offset(buckets, i * 8), ei + 1)
                store(offset(m, 24), ei + 1)
                if (ei + 1) * 4 >= cap * 3 { mp_grow[K, V](m) }
                return
            }
            ei := slot - 1
            cell := offset(entries, ei * stride)
            if call_eq(fe, cell, qk) {
                store(offset(cell, size_of[K]()), v)
                return
            }
            i = (i + 1) & mask
        }
    }
}

# Double the capacity, copy the entries array IN INSERTION ORDER (so iteration order
# survives a grow — the LOCK), and rebuild `buckets` by rehashing each entry's key.
# The entries are copied whole before the new arrays are published, and the rehash reads
# them from the new backing: a user hash may allocate and collect, and the header is the
# only thing that traces entries (a backing has no layout of its own).
fn mp_grow[K, V](m: gc_array[int]) {
    dp := descriptor_of[K]()
    unsafe {
        fh := offset(text_base(), load(offset(dp, 24)))
        stride := size_of[K]() + size_of[V]()
        cap := load(offset(m, 16))
        len := load(offset(m, 24))
        oe: rawptr = load(offset(m, 8))
        nc := cap * 2
        nb := gc_alloc(nc * 8, 0)
        ne := gc_alloc(nc * stride, 0)
        memcpy(ne, oe, len * stride)
        store(offset(m, 0), nb)
        store(offset(m, 8), ne)
        store(offset(m, 16), nc)
        mask := nc - 1
        j := 0
        while j < len {
            b := call_hash(fh, offset(ne, j * stride)) & mask
            while load(offset(nb, b * 8)) != 0 { b = (b + 1) & mask }
            store(offset(nb, b * 8), j + 1)
            j = j + 1
        }
    }
}
