# A `core/` module, so it is allowlisted to name the heap intrinsics. It exposes the
# self-checks the integration harness drives (the harness can only observe the child's
# exit code, so every invariant is proven here and surfaced as a return value).

import core/mem

pub fn selftest() -> int {
    c := gc_alloc(16, 0)
    return unsafe {
        store(c, 42)
        load(c)
    }
}

# Two cells must be distinct, non-overlapping, and both born zeroed. Writing 111/222
# and reading each back proves they do not alias; the pre-write reads prove zero-on-
# alloc. A no-op readback could not pass this.
pub fn check_distinct_zeroed() -> int {
    c1 := gc_alloc(16, 0)
    c2 := gc_alloc(16, 0)
    return unsafe {
        z1 := load(c1)
        z2 := load(c2)
        store(c1, 111)
        store(c2, 222)
        a := load(c1)
        b := load(c2)
        if z1 == 0 && z2 == 0 && a == 111 && b == 222 { 1 } else { 0 }
    }
}

# Allocate well past two 16 KiB spans so at least two refills happen, then report how
# many spans exist. Every cell is written to prove it is real, mapped storage — a cell
# handed out past a span's true limit would fault here rather than pass.
pub fn check_span_growth() -> int {
    i := 0
    loop {
        if i >= 700 { break }
        p := gc_alloc(64, 0)
        unsafe { store(p, i) }
        i = i + 1
    }
    return gc_span_count()
}

# A self-referential cycle must be traced without the marker looping (the mark bit stops
# re-push) and later swept without crashing. `cyc` builds two mutually-pointing cells and
# collects while they are rooted (exercising the cycle trace); back here they are dead, and
# the churn-driven collection reclaims them. Reaching the return (no hang, no fault) is 1.
fn cyc() {
    a := gc_alloc(16, layout_of[rawptr]())
    b := gc_alloc(16, layout_of[rawptr]())
    unsafe {
        store(a, b)
        store(b, a)
    }
    gc_collect()
}

pub fn ref_cycle_reclaimed() -> int {
    cyc()
    i := 0
    loop {
        if i >= 20000 { break }
        junk := gc_alloc(64, 0)
        unsafe { store(junk, i) }
        i = i + 1
    }
    return 1
}

# A large object (> 8 KiB, so it takes the direct-mmap path, not the size-class arena)
# must be traced, marked, and survive a forced collection while rooted. `big` holds 9 at
# its head; churning smaller cells forces a collection, after which the large span's value
# must still read back. Reads 9.
pub fn large_object_survivor() -> int {
    big := gc_alloc(16384, 0)
    unsafe { store(big, 9) }
    i := 0
    loop {
        if i >= 20000 { break }
        junk := gc_alloc(64, 0)
        unsafe { store(junk, i) }
        i = i + 1
    }
    return unsafe { load(big) }
}

# Force the malloc-backed mark stack to realloc-grow past its initial 4096-entry capacity:
# a single wide object holding > 4096 child pointers pushes them all in one trace step, so
# the mark stack must double mid-collection. Every child stays rooted through the wide
# object, so all survive; reading `arr[0]`'s payload back proves the grow kept the stack
# coherent. Reads 42.
pub fn mark_stack_grow() -> int {
    n := 4200
    arr := mem.ga_with_cap[rawptr](n)
    i := 0
    loop {
        if i >= n { break }
        c := gc_alloc(16, 0)
        unsafe { store(offset(c, 8), 42) }
        mem.ga_push[rawptr](arr, c)
        i = i + 1
    }
    gc_collect()
    c0 := mem.ga_get[rawptr](arr, 0)
    return unsafe { load(offset(c0, 8)) }
}

# Churn dropped large objects (each > 8 KiB, so each is a direct mmap swept by munmap)
# across many collections while ONE large object stays rooted. The sweep must munmap every
# dead large span (no leak, no crash) yet never free the rooted one — the rooted value must
# still read back. Reads 9.
pub fn large_churn_survivor() -> int {
    keep := gc_alloc(16384, 0)
    unsafe { store(keep, 9) }
    i := 0
    loop {
        if i >= 3000 { break }
        junk := gc_alloc(16384, 0)
        unsafe { store(junk, i) }
        i = i + 1
    }
    return unsafe { load(keep) }
}

# The allocation budget between collections must scale with the live heap (GOGC=100
# pacing), or a growing live set pays a whole-heap trace every fixed budget and the total
# GC time grows quadratically. Root ~9 MiB (a 1 MiB large array of 131072 64-byte cells),
# well above the 4 MiB floor, collect once to measure it, then churn 6 MiB: past the floor
# but below the live-sized budget, so no collection may run (a fixed 4 MiB trigger runs
# one). Churning 6 MiB more crosses the budget and must collect. Returns 1; 100+k when k
# collections ran inside the budget, 2 when none ran past it.
pub fn live_paced_collections() -> int {
    n := 131072
    arr := mem.ga_with_cap[rawptr](n)
    i := 0
    loop {
        if i >= n { break }
        mem.ga_push[rawptr](arr, gc_alloc(64, 0))
        i = i + 1
    }
    gc_collect()
    s0 := gc_stats()
    j := 0
    loop {
        if j >= 98304 { break }
        junk := gc_alloc(64, 0)
        unsafe { store(junk, j) }
        j = j + 1
    }
    s1 := gc_stats()
    k := 0
    loop {
        if k >= 98304 { break }
        junk := gc_alloc(64, 0)
        unsafe { store(junk, k) }
        k = k + 1
    }
    s2 := gc_stats()
    if mem.ga_len[rawptr](arr) != n { return 3 }
    if s1 != s0 { return 100 + s1 - s0 }
    if s2 == s1 { return 2 }
    return 1
}

# A large object whose only root points into its third 16 KiB page must survive. The
# collector resolves a word's span by the word's page, so every page of a large object has
# to resolve to it. A swept object is munmapped and the read faults. Reads 9.
fn large_interior() -> rawptr {
    big := gc_alloc(65536, 0)
    mid := offset(big, 40000)
    unsafe { store(mid, 9) }
    return mid
}

pub fn large_interior_survivor() -> int {
    mid := large_interior()
    i := 0
    loop {
        if i >= 20000 { break }
        junk := gc_alloc(64, 0)
        unsafe { store(junk, i) }
        i = i + 1
    }
    return unsafe { load(mid) }
}

# Every page of a 1 MiB object resolves to it: the only root points into its last page,
# while dropped large objects are mapped and unmapped around it across collections. A swept
# object is unmapped and the read faults. Reads 9.
fn large_last_page() -> rawptr {
    big := gc_alloc(1048576, 0)
    last := offset(big, 1048568)
    unsafe { store(last, 9) }
    return last
}

pub fn large_last_page_survivor() -> int {
    last := large_last_page()
    i := 0
    loop {
        if i >= 200 { break }
        junk := gc_alloc(65536 + i * 16384, 0)
        unsafe { store(junk, i) }
        i = i + 1
    }
    gc_collect()
    return unsafe { load(last) }
}

# Spans come from 64 MiB arenas, so a live heap past one makes the collector map a second
# and find spans in both. Keep 1150000 64-byte cells (about 70 MiB) live, each holding its
# index, across collections. Returns 1; 2 when a cell lost its value.
pub fn arena_growth() -> int {
    n := 1150000
    arr := mem.ga_with_cap[rawptr](n)
    i := 0
    loop {
        if i >= n { break }
        c := gc_alloc(64, 0)
        unsafe { store(offset(c, 56), i) }
        mem.ga_push[rawptr](arr, c)
        i = i + 1
    }
    gc_collect()
    j := 0
    loop {
        if j >= 100000 { break }
        junk := gc_alloc(64, 0)
        unsafe { store(junk, j) }
        j = j + 1
    }
    gc_collect()
    k := 0
    while k < n {
        v := unsafe { load(offset(mem.ga_get[rawptr](arr, k), 56)) }
        if v != k { return 2 }
        k = k + 1
    }
    return 1
}

# Spans the sweep finds empty serve any size class, and a reused span hands out zeroed
# cells. Fill about 20 spans with 16-byte cells holding nonzero words, drop them all and
# collect, then take 15 spans' worth of 64-byte cells: within the budget, so no collection
# runs, and the span count must not grow. Returns 1; 100+n when n spans were mapped
# anyway, 2 when a cell came back dirty.
pub fn empty_spans_reused() -> int {
    i := 0
    loop {
        if i >= 16120 { break }
        p := gc_alloc(16, 0)
        unsafe {
            store(p, i + 1)
            store(offset(p, 8), i + 1)
        }
        i = i + 1
    }
    gc_collect()
    s0 := gc_span_count()
    dirty := 0
    j := 0
    loop {
        if j >= 3015 { break }
        q := gc_alloc(64, 0)
        k := 0
        while k < 64 {
            w := unsafe { load(offset(q, k)) }
            if w != 0 { dirty = dirty + 1 }
            k = k + 8
        }
        j = j + 1
    }
    grown := gc_span_count() - s0
    if grown != 0 { return 100 + grown }
    if dirty != 0 { return 2 }
    return 1
}

# A program whose heap stays small never pays for a collection: the budget has a 4 MiB
# floor, Go's minimum heap. Churn 3 MiB of 64-byte cells with nothing live. Returns 1;
# 100+k when k collections ran.
pub fn pacing_floor() -> int {
    s0 := gc_stats()
    i := 0
    loop {
        if i >= 49152 { break }
        junk := gc_alloc(64, 0)
        unsafe { store(junk, i) }
        i = i + 1
    }
    k := gc_stats() - s0
    if k != 0 { return 100 + k }
    return 1
}

# `store_u32` writes the low 4 bytes of its value and nothing around them. Returns 1; 2
# when the word it wrote into is wrong, 3 when a neighbour changed.
pub fn store_u32_narrow() -> int {
    p := gc_alloc(32, 0)
    unsafe {
        store(p, -1)
        store(offset(p, 8), -1)
        store(offset(p, 16), -1)
        store_u32(offset(p, 12), 0x1_2345_6789)
        if load(offset(p, 8)) != 0x2345_6789_FFFF_FFFF { return 2 }
        if load(p) != -1 || load(offset(p, 16)) != -1 { return 3 }
    }
    return 1
}

# The Vec shape: an empty array has no backing until its first push, and a sized one has
# exactly the room it asked for. Returns 1, or the number of the first check that failed.
pub fn vec_shape() -> int {
    a := mem.ga_new[int]()
    if cap_of(a) != 0 || backing_of(a) != 0 { return 2 }
    z := mem.ga_with_cap[int](0)
    if cap_of(z) != 0 || backing_of(z) != 0 { return 3 }
    neg := mem.ga_with_cap[int](-2)
    if cap_of(neg) != 0 || backing_of(neg) != 0 { return 8 }
    gc_collect()
    mem.ga_push[int](a, 7)
    if cap_of(a) != 4 || mem.ga_len[int](a) != 1 || mem.ga_get[int](a, 0) != 7 { return 4 }
    b := mem.ga_with_cap[int](3)
    if cap_of(b) != 3 || !inline(b) { return 5 }
    if inline(mem.ga_with_cap[int](6)) { return 7 }
    i := 0
    while i < 4 {
        mem.ga_push[int](b, i)
        i = i + 1
    }
    if cap_of(b) != 6 || mem.ga_get[int](b, 3) != 3 { return 6 }
    return 1
}

# A list literal's Vec, built through the sugar: exactly its length in capacity, with a
# short one's elements inline. `small_vec` is [1, 2, 3], `big_vec` six elements. Returns
# 1, or the number of the first check that failed.
pub fn literal_shape[V](small_vec: V, big_vec: V) -> int {
    small := handle_of[V](small_vec)
    big := handle_of[V](big_vec)
    if cap_of(small) != 3 || mem.ga_len[int](small) != 3 || !inline(small) { return 2 }
    if mem.ga_get[int](small, 2) != 3 { return 3 }
    if cap_of(big) != 6 || mem.ga_len[int](big) != 6 || inline(big) { return 4 }
    return 1
}

# The handle inside a `Vec[int]`, whose one field is private to std/vec.
fn handle_of[V](v: V) -> gc_array[int] {
    if size_of[V]() != 8 { panic("a Vec is not one handle") }
    at := gc_alloc(8, 0)
    unsafe { store(at, v) }
    return unsafe { load(at) }
}

fn cap_of(a: gc_array[int]) -> int {
    return unsafe { load(offset(a, 8)) }
}

# Whether the elements sit in the header's own cell, just past its three words. A rawptr
# has no `==` and no cast to int, so the address goes through memory to be read as an int.
fn inline(a: gc_array[int]) -> bool {
    at := gc_alloc(8, 0)
    unsafe { store(at, offset(a, 24)) }
    return backing_of(a) == unsafe { load(at) }
}

fn backing_of(a: gc_array[int]) -> int {
    return unsafe { load(offset(a, 16)) }
}

# A span of noscan cells has no layout table, so its cells start right after the header:
# 16-byte ones fill 1008 to a span, where a span that records a layout per 16 bytes holds
# 806. Take ten noscan spans' worth and count the spans mapped. Returns 1; 100+n when n
# spans were mapped.
pub fn noscan_span_capacity() -> int {
    s0 := gc_span_count()
    i := 0
    while i < 10080 {
        p := gc_alloc(16, 0)
        unsafe { store(p, i) }
        i = i + 1
    }
    grown := gc_span_count() - s0
    if grown > 11 { return 100 + grown }
    return 1
}

# Marking reads no word of a noscan object, so an address kept only in one keeps nothing
# alive: the cell it names is swept and handed out again, zeroed. `anchor` keeps the span
# in use, so the sweep, not the span pool, takes the cell back. Returns 1; 2 when the cell
# survived.
fn hide(holder: rawptr) -> rawptr {
    anchor := gc_alloc(48, 0)
    target := gc_alloc(48, 0)
    unsafe {
        store(offset(target, 8), 9)
        store(holder, target)
    }
    return anchor
}

pub fn noscan_body_untraced() -> int {
    holder := gc_alloc(16, 0)
    anchor := hide(holder)
    gc_collect()
    again := gc_alloc(48, 0)
    unsafe { store(offset(again, 8), 5) }
    at: int = unsafe { load(holder) }
    cell := gc_alloc(8, 0)
    unsafe { store(cell, at + 8) }
    p: rawptr = unsafe { load(cell) }
    v: int = unsafe { load(p) }
    unsafe { store(offset(anchor, 8), 1) }
    if v == 9 { return 2 }
    return 1
}

# A backing's span kind comes from its element type: a Vec of ints keeps its elements in a
# noscan cell, one of references in a container cell, never in a noscan one. Interleave
# 48-byte noscan cells with 48-byte backings (six elements, too many for the header's own
# cell) and count the spans mapped: one for the headers, then one more for the 48-byte
# cells when the backings are noscan too, two when they are containers. Returns the
# spans mapped.
pub fn int_backing_spans() -> int {
    s0 := gc_span_count()
    keep := mem.ga_with_cap[gc_array[int]](168)
    i := 0
    while i < 168 {
        mem.ga_push[gc_array[int]](keep, mem.ga_with_cap[int](6))
        p := gc_alloc(48, 0)
        unsafe { store(p, i) }
        i = i + 1
    }
    return gc_span_count() - s0
}

pub fn ref_backing_spans() -> int {
    s0 := gc_span_count()
    keep := mem.ga_with_cap[gc_array[rawptr]](168)
    i := 0
    while i < 168 {
        mem.ga_push[gc_array[rawptr]](keep, mem.ga_with_cap[rawptr](6))
        p := gc_alloc(48, 0)
        unsafe { store(p, i) }
        i = i + 1
    }
    return gc_span_count() - s0
}

# A pooled span changes kind when another list takes it: a mixed span's cells start past its
# layout table, a noscan span's right after the header, with mark bits for 1008 cells. Fill
# 20 spans with mixed 16-byte cells and drop them, then keep 15 spans' worth of noscan
# 16-byte cells live across a collection, then the reverse, mixed cells whose only
# reference is to a noscan cell. Returns 1; 2 when a reused cell came back dirty, 3 when a
# live noscan cell lost its value, 4 when a mixed cell or its target did.
fn fill_mixed(n: int) {
    i := 0
    while i < n {
        p := gc_alloc(16, layout_of[rawptr]())
        unsafe { store(offset(p, 8), i + 1) }
        i = i + 1
    }
}

fn noscan_phase(n: int) -> int {
    keep := mem.ga_with_cap[rawptr](n)
    i := 0
    while i < n {
        p := gc_alloc(16, 0)
        if word_at(p, 0) != 0 || word_at(p, 8) != 0 { return 2 }
        unsafe {
            store(p, i + 7)
            store(offset(p, 8), i + 7)
        }
        mem.ga_push[rawptr](keep, p)
        i = i + 1
    }
    gc_collect()
    fill_mixed(4000)
    j := 0
    while j < n {
        p := mem.ga_get[rawptr](keep, j)
        if word_at(p, 0) != j + 7 || word_at(p, 8) != j + 7 { return 3 }
        j = j + 1
    }
    return 1
}

fn mixed_phase(n: int) -> int {
    keep := mem.ga_with_cap[rawptr](n)
    i := 0
    while i < n {
        p := gc_alloc(16, layout_of[rawptr]())
        if word_at(p, 0) != 0 || word_at(p, 8) != 0 { return 2 }
        t := gc_alloc(16, 0)
        unsafe {
            store(t, i + 5)
            store(p, t)
            store(offset(p, 8), i + 5)
        }
        mem.ga_push[rawptr](keep, p)
        i = i + 1
    }
    gc_collect()
    j := 0
    while j < n {
        p := mem.ga_get[rawptr](keep, j)
        t: rawptr = unsafe { load(p) }
        if word_at(p, 8) != j + 5 || word_at(t, 0) != j + 5 { return 4 }
        j = j + 1
    }
    return 1
}

fn word_at(p: rawptr, k: int) -> int {
    return unsafe { load(offset(p, k)) }
}

pub fn span_kind_change() -> int {
    fill_mixed(16120)
    gc_collect()
    r := noscan_phase(15120)
    if r != 1 { return r }
    gc_collect()
    return mixed_phase(8000)
}
