# The quarantined libSystem process clients: argv, the environment, errno, exit and the
# clocks. C strings are copied into gc strs on the way in (D66), so no toy str ever points
# into C memory that a later setenv or exit could free.
import core/target
import core/text

pub extern fn _NSGetArgc() -> rawptr
pub extern fn _NSGetArgv() -> rawptr
# getenv returns a nullable char*. Typed int so null is a plain 0 compare; `offset(p, 0)`
# turns a non-null one back into the rawptr from_cstr reads.
pub extern fn getenv(name: rawptr) -> int
pub extern fn strlen(s: rawptr) -> int
pub extern fn exit(code: int) -> never
pub extern fn __error() -> rawptr
pub extern fn __errno_location() -> rawptr
# Returns a uint64, which stays positive in an int for the next 292 years.
pub extern fn clock_gettime_nsec_np(clock: int) -> int
pub extern fn nanosleep(req: rawptr, rem: rawptr) -> int

# A C `int` is 4 bytes and `load` reads 8, so the next 4 would be whatever follows it.
fn load_i32(p: rawptr) -> int {
    v := 0
    for i in 0..4 {
        v = (v << 8) | unsafe { load_byte(offset(p, 3 - i)) }
    }
    return v
}

# A copy of the NUL-terminated bytes at `p`.
pub fn from_cstr(p: rawptr) -> str {
    n := unsafe { strlen(p) }
    buf := text.alloc(n)
    w := text.window(buf, 0, n)
    for i in 0..n {
        unsafe { store_byte(offset(w, i), load_byte(offset(p, i))) }
    }
    return text.take(buf, n)
}

# `s` with a NUL appended, for a C call. The address points into a gc buffer the caller
# hands straight to the call, as with `text.window`.
pub fn to_cstr(s: str) -> rawptr {
    n := s.len()
    buf := text.alloc(n + 1)
    text.put(buf, 0, s)
    unsafe { store_byte(text.window(buf, n, 1), 0) }
    return text.window(buf, 0, n + 1)
}

# The cstr of std/ffi: the same NUL-terminated gc copy as `to_cstr`, which the collector
# keeps alive while toy code holds the cstr, as it would a rawptr. The cell is allocated
# before the copy, so the copy is never held across an allocation.
pub fn cstr_of(s: str) -> cstr {
    cell := gc_alloc(8, layout_of[cstr]())
    unsafe { store(cell, to_cstr(s)) }
    c: cstr = unsafe { load(cell) }
    return c
}

# A cstr is not a rawptr to toy code, so its address is read back through a cell.
fn cstr_addr(c: cstr) -> rawptr {
    cell := gc_alloc(8, layout_of[cstr]())
    unsafe { store(cell, c) }
    p: rawptr = unsafe { load(cell) }
    return p
}

pub fn cstr_is_null(c: cstr) -> bool {
    cell := gc_alloc(8, layout_of[cstr]())
    unsafe { store(cell, c) }
    p: int = unsafe { load(cell) }
    return p == 0
}

pub fn cstr_to_str(c: cstr) -> str {
    if cstr_is_null(c) { panic("to_str of a null cstr") }
    return from_cstr(cstr_addr(c))
}

# The calling thread's errno, as the last failed libSystem call left it.
pub fn errno() -> int {
    return load_i32(errno_loc())
}

# Both externs are always declared; only the taken arm is lowered, so a binary imports
# just its own OS's symbol.
pub fn errno_loc() -> rawptr {
    return when target.os {
        .macos -> unsafe { __error() },
        .linux -> unsafe { __errno_location() },
    }
}

# std cannot name an extern, so it ends the process through this wrapper.
pub fn exit_process(code: int) -> never {
    unsafe { exit(code) }
}

pub fn argc() -> int {
    return load_i32(unsafe { _NSGetArgc() })
}

# argv[i] as a copied str; the caller keeps `0 <= i < argc()`.
pub fn argv(i: int) -> str {
    base: int = unsafe { load(_NSGetArgv()) }
    p: int = unsafe { load(offset(base, i * 8)) }
    return from_cstr(offset(p, 0))
}

# The value of the environment variable `name`, or none when it is unset.
pub fn env(name: str) -> Option[str] {
    p := unsafe { getenv(to_cstr(name)) }
    if p == 0 { return Option[str].none }
    return Option.some(from_cstr(offset(p, 0)))
}

# Darwin's CLOCK_MONOTONIC (6). It keeps counting while the machine sleeps, so an elapsed
# time includes the sleep, as a wall-clock duration should.
pub fn monotonic_ns() -> int {
    return unsafe { clock_gettime_nsec_np(6) }
}

# Darwin's CLOCK_REALTIME (0): nanoseconds since 1970.
pub fn realtime_ns() -> int {
    return unsafe { clock_gettime_nsec_np(0) }
}

# Sleeps at least `ns` nanoseconds. A signal cuts nanosleep short and leaves what remains in
# `rem` (EINTR is 4), so it sleeps again for that remainder.
pub fn sleep_ns(ns: int) {
    if ns <= 0 { return }
    req := gc_alloc(16, 0)
    rem := gc_alloc(16, 0)
    unsafe {
        store(req, ns / 1_000_000_000)
        store(offset(req, 8), ns % 1_000_000_000)
    }
    while (unsafe { nanosleep(req, rem) }) != 0 && errno() == 4 {
        unsafe {
            store(req, load(rem))
            store(offset(req, 8), load(offset(rem, 8)))
        }
    }
}

# getentropy(2) fills at most 256 bytes and fails only for a bad buffer or a larger
# request, so a failure here is a bug, not a condition a caller could handle.
pub extern fn getentropy(buf: rawptr, len: int) -> int

# 64 bits from the kernel's CSPRNG.
pub fn entropy_u64() -> uint64 {
    buf := gc_alloc(8, 0)
    if (unsafe { getentropy(buf, 8) } & 0xFFFF_FFFF) != 0 { panic("getentropy failed") }
    v: uint64 = unsafe { load(buf) }
    return v
}
