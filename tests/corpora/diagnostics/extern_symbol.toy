# Each extern the program calls must be exported by the library it binds to: a bare extern
# by libSystem (and what it re-exports, such as libm), a block's by its library, here a
# shared-cache one that dyld answers for. `check` reports it as `build` does; an extern
# no code calls is not checked. The signatures are the fixture's own.
extern fn labs(x: int) -> int
extern fn putz(x: int) -> int  #~ ERROR [R0019] C symbol 'putz' is not exported by libSystem; a bare 'extern fn' binds to libSystem
extern fn putz_never(x: int) -> int

extern "z" {
    fn crc32(crc: int, p: int, n: int) -> int
    fn crc_32(crc: int, p: int, n: int) -> int  #~ ERROR [R0019] C symbol 'crc_32' is not exported by library 'z'
    fn puts(x: int) -> int  #~ ERROR [R0019] C symbol 'puts' is not exported by library 'z'
    fn crc_never(crc: int) -> int
}

fn main() -> int {
    unsafe { labs(-1) + crc32(0, 0, 0) + crc_32(0, 0, 0) + putz(1) + puts(1) }
}
