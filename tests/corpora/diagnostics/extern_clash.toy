# A C symbol comes from one library. A block that binds one the toy runtime or a bundled
# module imports from the system C library is the conflict, reported at the block's extern.
import std/io

extern "z" {
    fn write(fd: int, p: rawptr, n: int) -> int  #~ ERROR [R0018] C symbol 'write' is bound to library 'z' here but to the system C library by the toy runtime
    fn strlen(p: rawptr) -> int  #~ ERROR [R0018] C symbol 'strlen' is bound to library 'z' here but to the system C library in module 'core/os'
}

fn main() -> int {
    io.print("x\n")
    0
}
