extern fn printf(f: cstr, ...) -> int32
extern fn mk() -> cstr
extern struct P { x: int }

fn main() -> int {
    n: int32 = 3
    x: f32 = 1.5
    s := unsafe { mk() }
    a := unsafe { printf(s, 1, 2.5, s) }
    b := unsafe { printf(s, n) }  #~ ERROR [T0081] a C variadic argument must be int, int64, uint64, float, cstr or rawptr, got 'int32'; widen it first, as in 'w: int = n.into()'
    c := unsafe { printf(s, x) }  #~ ERROR [T0081] a C variadic argument must be int, int64, uint64, float, cstr or rawptr, got 'f32'; convert it first, as in 'd: float = x.into()'
    d := unsafe { printf(s, true) }  #~ ERROR [T0081] a C variadic argument must be int, int64, uint64, float, cstr or rawptr, got 'bool'; pass an int, as in 'if b { 1 } else { 0 }'
    e := unsafe { printf(s, "hi") }  #~ ERROR [T0081] a C variadic argument must be int, int64, uint64, float, cstr or rawptr, got 'str'; pass 's.to_cstr()' (std/ffi)
    f := unsafe { printf(s, P { x: 1 }) }  #~ ERROR [T0081] a C variadic argument must be int, int64, uint64, float, cstr or rawptr, got 'P'
    g := unsafe { printf() }  #~ ERROR [T0039] expected at least 1 argument(s), got 0; 'printf' takes (cstr, ...)
    h := printf(s)  #~ ERROR [T0079] call to extern function 'printf' requires an 'unsafe' block
    return (a + b + c + d + e + f + g + h).into()
}
