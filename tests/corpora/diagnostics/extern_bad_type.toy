struct P { x: int }

extern "c" {
    fn puts(s: str) -> int32  #~ ERROR [T0037] an extern function cannot take a 'str', which is not NUL-terminated; take a 'cstr' and pass 's.to_cstr()' (std/ffi)
    fn getenv(name: rawptr) -> str  #~ ERROR [T0037] an extern function cannot return a 'str'; return a 'cstr' and copy it with 'c.to_str()' (std/ffi)
    fn abs(p: P) -> int  #~ ERROR [T0037] extern function parameter/return type must be int, float, float32, rawptr, cstr, bool, or an extern struct
}

fn main() -> int {
    _n := unsafe { puts("one error per bad extern; its calls still check") }
    return unsafe { abs(P { x: 1 }) }
}
