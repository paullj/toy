# Feature: a debug build's overflow test fires only past the edge. Every `+`, `-`, `*` and
# unary `-` here lands exactly on its type's min or max, at each width and signedness,
# directly and through the compound forms, so none panics.
# expect: stdout "127\n-128\n-127\n-128\n64\n255\n0\n255\n0\n32767\n-32768\n2147483647\n-2147483648\n4294967295\n0\n65535\n9223372036854775807\n-9223372036854775808\n-9223372036854775807\n-9223372036854775808\n18446744073709551615\n0\n18446744073709551615\n4294967296\n"
import std/io

fn main() {
    a: int8 = 126
    b: int8 = -127
    m: int8 = 8
    n: int8 = -16
    io.println(a + 1)
    io.println(b - 1)
    io.println(-(a + 1))
    io.println(n * m)
    io.println(m * m)
    u: uint8 = 254
    z: uint8 = 1
    k: uint8 = 15
    io.println(u + z)
    io.println(z - z)
    io.println(k * 17)
    io.println(-(z - z))
    h: int16 = 32766
    h += 1
    lo: int16 = -32767
    lo -= 1
    i: int32 = 2147483646
    j: int32 = -2147483647
    io.println(h)
    io.println(lo)
    io.println(i + 1)
    io.println(j - 1)
    w: uint32 = 65535
    v: uint32 = 65537
    q: uint16 = 255
    q *= 257
    io.println(w * v)
    io.println(w - w)
    io.println(q)
    x := 9223372036854775806
    y := -9223372036854775807
    io.println(x + 1)
    io.println(y - 1)
    io.println(-(x + 1))
    io.println(y + -1)
    p: uint64 = 18446744073709551614
    one: uint64 = 1
    big: uint64 = 4294967295
    r: uint64 = 65536
    r *= 65536
    io.println(p + one)
    io.println(p - p)
    io.println(big * 4294967297)
    io.println(r)
}
