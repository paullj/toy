# Feature: float32 is a single-precision float. A float literal takes float32 where one is
# expected, the dotted operators and == work on two float32s, `into` widens to float exactly,
# narrows a float by rounding and converts an int, `try_into` gives an int, and a float32
# prints the shortest digits that read back as the same float32.
# expect: stdout "1.5\n0.1\n0.1\n0.10000000149011612\n3.4028235e38\n16777216.0\n1.0e-7\ntrue\nfalse\n2\nP{x: 0.25, n: 3}\nsome(2.5)\ninf\nNaN\n-0.0\n"
# expect: exit 0
import std/io

struct P { x: float32, n: int }

fn half(x: float32) -> float32 {
    return x /. 2.0
}

fn main() -> int {
    a: float32 = 1.5
    io.println(a)
    tenth: float32 = 0.1
    io.println(tenth)
    d: float = 0.1
    narrowed: float32 = d.into()
    io.println(narrowed)
    wide: float = tenth.into()
    io.println(wide)
    big: float32 = 3.4028235e38
    io.println(big)
    n: int = 16777217
    fromint: float32 = n.into()
    io.println(fromint)
    io.println(half(0.0000002))
    io.println(tenth == narrowed)
    io.println(a <. tenth)
    k: int = (a +. 0.75).try_into().expect("in range")
    io.println(k)
    io.println(P { x: half(0.5), n: 3 })
    io.println(Option.some(a +. 1.0))
    inf: float32 = big *. 10.0
    io.println(inf)
    io.println(inf -. inf)
    io.println(0.0 *. (0.0 -. tenth))
    return 0
}
