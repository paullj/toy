# Feature: the allocation fast path spliced into a loop body lays the loop's blocks out
# apart, so the register allocator evicts `flag` with its store moved back to a block
# boundary before the evicting value. Its reload must not start there too: it took a
# register `wrapped` still held, and f1 read `flag` (1) where `wrapped` (0) belonged.
# expect: stdout "0\n0\n0\n0\n0\n0\n0\n"
# expect: exit 0
import std/io
import std/vec

struct H { v: Vec[int], n: int }

fn pick[T](c: bool, a: T, b: T) -> T { if c { a } else { b } }

fn out_of_line() -> float {
    if false {
        i := 0
        while i < 2 {
        }
    }
    return 51.55
}

fn f1(v6: Vec[int], v7: H, v8: int, v9: int, v10: int, v11: float, v12: int, v13: H, wrapped: int, v15: int, v16: float) -> int {
    if v15 == -89 {
        i := 0
        while i < 3 {
        }
    }
    return wrapped
}

fn f2(x: float, shift: int, by_value: int, mut by_ref: int, flag: bool) -> int {
    i := 0
    while i < 2 {
        j := 0
        while j < 3 {
            io.println(f1([], H { v: [], n: 0 }, by_ref | (i << (shift & 63)), 0, 0, 1.5, 0, H { v: [pick(flag, j, by_ref)], n: 2 }, (-9223372036854775808) *% (by_ref ^ (-9223372036854775808)), if x <=. x { by_value } else { 4294967296 }, out_of_line()))
            j += 1
        }
        i += 1
    }
    return 0
}

fn main() -> int {
    m := 38
    io.println(f2(2.5, 96, 38, m, true))
    return 0
}
