# expect: exit 42
# Feature: a derivable type that ALSO holds a managed `Ref` field. Deriving `Eq` on it
# (compared with `==`) compares the Ref field by cell identity; the derived unit and the
# layout the collector traces a Node by are both re-lowered by the -jN determinism gate.
import std/ref

struct Node { v: int, next: Ref[int] }

fn main() -> int {
    r := Ref.new(1)
    a := Node{ v: 42, next: r }
    b := Node{ v: 42, next: r }   # same cell: `next` compares equal by identity
    return if a == b { a.v } else { 0 }
}
